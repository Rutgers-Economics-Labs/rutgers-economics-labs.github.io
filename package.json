    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.523.0",
    "next": "^15.5.24",
    "postcss": "^8.5.25",
    "posthog-js": "^1.315.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "touch-cli": "^0.0.1"
  },
  "devDependencies": {
